# Copy to mydailyapps.env next to the executable and edit.
# Environment variables win over this file.

# guest = temp folder, wiped on exit.
# persistent = keep data between runs.
MYDAILYAPPS_MODE=persistent

# Where local state, caches and tokens live in persistent mode.
# Default: %AppData%\MyDailyApps on Windows, ~/Library/Application Support/MyDailyApps on macOS, ~/.config/MyDailyApps on Linux.
# MYDAILYAPPS_DATA_DIR=D:\MyDailyAppsData

# Port for the host UI and API.
MYDAILYAPPS_PORT=8080

# The apps folder: scanned for installed apps and used as the install target.
# Default: an apps folder next to the executable.
# MYDAILYAPPS_APPS_DIR=D:\Projects\apps

# Open the browser at startup.
MYDAILYAPPS_OPEN_BROWSER=true

# Google sign-in for Drive (OAuth client of type "Desktop app"). See README.
# MYDAILYAPPS_GOOGLE_CLIENT_ID=1234-abc.apps.googleusercontent.com
# MYDAILYAPPS_GOOGLE_CLIENT_SECRET=GOCSPX-...
